<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#08142A"
                android:centerColor="#0B1A33"
                android:endColor="#14305C"
                android:type="linear" />
        </shape>
    </item>
    <item
        android:width="200dp"
        android:height="90dp"
        android:gravity="center">
        <bitmap
            android:gravity="fill_horizontal|center_vertical"
            android:src="@drawable/swk_logo_white" />
    </item>
</layer-list>
